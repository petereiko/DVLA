@using DVLA.VerificationPortal.Shared.Enums
@using DVLA.VerificationPortal.Shared.Requests
@model OnboardUserRequest
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <!-- ----------------------------------------- -->
        <!-- 1. Basic Form -->
        <!-- ----------------------------------------- -->
        <!-- start Basic Form -->
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Fill Form</h4>
                <form asp-action="Create" method="post">

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" asp-for="Email" placeholder="name@example.com" required />
                                <label for="tb-email">Email address</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="PhoneNumber" required />
                                <label for="PhoneNumber">Phone Number</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="CentreName" placeholder="Enter Phone here" required />
                                <label for="CentreName">Centre Name</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <select asp-for="Role" class="form-control" asp-items="@Model.Roles" required>
                                    <option value="">Select User Role</option>
                                </select>
                                <label for="Role">Role</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-md-flex align-items-center">

                                <div class="ms-auto mt-3 mt-md-0">
                                    <button type="submit" class="btn btn-primary hstack gap-6">

                                        Submit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
    <!-- end Basic Form -->
    @section Scripts {
        @if (Model.Errors.Any())
        {
            <script>
                Swal.fire({
                    title: 'Error',
                    text: '@Model.Errors.FirstOrDefault()',
                    type: 'error'
                });
            </script>
        }
    }




