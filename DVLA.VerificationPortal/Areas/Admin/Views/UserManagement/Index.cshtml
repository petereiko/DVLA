@using DVLA.VerificationPortal.Shared.DTOs
@using DVLA.VerificationPortal.Shared.Responses

@model PaginatedResponse<ApplicationUserDto>
@{
    ViewData["Title"] = "User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            @* <div class="mb-2">
            <h4 class="card-title mb-0">File export</h4>
            </div> *@
            <p class="card-subtitle mb-3">
                <a asp-action="Create" asp-controller="UserManagement" asp-area="Admin" class="btn btn-primary">Create New @ViewData["Title"].ToString()</a>
            </p>
            <div class="table-responsive">
                <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                    <thead>
                        <!-- start row -->
                        <tr>
                            <th>Email</th>
                            <th>Centre</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                        <!-- end row -->
                    </thead>
                    <tbody>
                        @foreach (ApplicationUserDto item in Model.Items)
                        {
                            <!-- start row -->
                            <tr>
                                <td>@item.Email</td>
                                <td>@item.CentreName</td>
                                <td>@item.Role</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="mb-1 badge rounded-pill text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="mb-1 badge rounded-pill text-bg-danger">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Edit" asp-controller="UserManagement" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                </td>
                            </tr>
                            <!-- end row -->
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

