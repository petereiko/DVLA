@using DVLA.VerificationPortal.Shared
@using DVLA.VerificationPortal.Shared.DTOs
@using DVLA.VerificationPortal.Shared.Enums
@model VisualAssessmentResultDto
@inject IConfiguration _configuration;

@{
    ViewData["Title"] = "Visual Assessment Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eye Test Result</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Url.Content("~/bootstrapdemos.wrappixel.com/materialpro/dist/assets/libs/sweetalert2/dist/sweetalert2.min.css")" rel="stylesheet" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Roboto', sans-serif;
        }

        .card {
            margin-top: 20px;
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .btn {
            background-color: #34495E;
            color: white;
        }

        .btn-danger {
            background-color: red;
            color: white;
            border: 1px solid red;
            width: 100px;
        }

        .btn:hover {
            background-color: white;
            color: #34495E;
        }

        .card-header {
            background-color: #34495E;
            color: white;
            border-radius: 10px 10px 0 0;
        }

        .card-body {
            padding: 20px;
        }

        .result-section {
            margin-bottom: 20px;
        }

            .result-section h5 {
                color: #34495E;
            }

        h1 {
            font-weight: 700;
        }

        p {
            font-weight: 400;
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <br />
            <div class="col-md-8">
                <br />
                <center>
                    <img src="~/logos/ODDVLAmonochromeblack.png" style="width:100px; height:100px;" />
                </center>
                <div class="card">
                    <div class="card-header text-center">
                        <h3>Eye Test Result</h3>
                    </div>
                    <div class="card-body">
                        <!-- Patient Information -->
                        @{
                            string email = string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email;
                        }
                        <div class="row">
                            <div class="col-sm-8">
                                <h5>Applicant Information</h5>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <tr>
                                            <td>Name:</td>
                                            <td>@Model.FirstName @Model.Surname</td>
                                        </tr>
                                        <tr>
                                            <td>Date of Birth:</td>
                                            <td>@Model.DOB?.ToString("yyyy MMM dd")</td>
                                        </tr>
                                        <tr>
                                            <td>Email:</td>
                                            <td>@email</td>
                                        </tr>
                                        <tr>
                                            <td>Contact:</td>
                                            <td>@Model.ContactNumber</td>
                                        </tr>
                                        <tr>
                                            <td>Address:</td>
                                            <td>@Model.PostalAddress</td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(Model.NationalID))
                                        {
                                            <tr>
                                                <td>National ID:</td>
                                                <td>@Model.NationalID</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.PassportNumber))
                                        {
                                            <tr>
                                                <td>Passport Number:</td>
                                                <td>@Model.PassportNumber</td>
                                            </tr>
                                        }

                                        <tr>
                                            <td>DVLA License Number:</td>
                                            <td>
                                                @{
                                                    string licenseNumber="N/A";
                                                    if (!string.IsNullOrEmpty(Model.DvlaLicenseNumber))
                                                    {
                                                        licenseNumber = Model.DvlaLicenseNumber;
                                                    }
                                                    <span>@licenseNumber</span>
                                                }
                                            </td>
                                        </tr>


                                    </table>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                @if (!Model.IsVerified)
                                {
                                    string token = Utility.EncryptUrlID((int)Model.Id);
                                    <button onclick="VerifyResult('@token')" class="btn btn-primary btn-sm right">Verify Eye Test Result</button>
                                }
                                else
                                {
                                    <img src="~/logos/verify.jpeg" width="80" height="80" />
                                }
                                <br /><br />
                                @{
                                    string passportUrl = $"{_configuration["AppConstants:PassportUrl"]}{Model.PassportImageUrl}";
                                }
                                <img class="img-thumbnail" width="150" height="150" src="@passportUrl" alt="Passport Photo" />
                            </div>
                        </div>
                        <br />
                        @* <div class="row">
                            <div class="col-sm-12">
                                <h5>Test Results</h5>
                            </div>
                            <div class="col-sm-6">
                                <table class="table table-bordered table-striped">
                                    <tr>
                                        <td style="width:70%">BCV_OD:</td>
                                        <td>@Model.BCV_OD</td>
                                    </tr>
                                    <tr>
                                        <td>BCV_OS:</td>
                                        <td>@Model.BCV_OS</td>
                                    </tr>
                                    <tr>
                                        <td>BCV_OU:</td>
                                        <td>@Model.BCV_OU</td>
                                    </tr>
                                    <tr>
                                        <td>ColourVision BCV_OU</td>
                                        <td>@Model.ColourVision_BCV_OU</td>
                                    </tr>
                                    <tr>
                                        <td>ContrastSensitivity BCV:</td>
                                        <td>@Model.ContrastSensitivity_BCV</td>
                                    </tr>
                                    <tr>
                                        <td>SingleImage BCV_OU</td>
                                        <td>@Model.SingleImage_BCV_OU</td>
                                    </tr>
                                    <tr>
                                        <td>GlareTest BCV_OU</td>
                                        <td>@Model.GlareTest_BCV_OU</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-sm-6">
                                <table class="table table-bordered table-striped">
                                    <tr>
                                        <td style="width:70%">HX_BCV_OD:</td>
                                        <td>@Model.HX_BCV_OD</td>
                                    </tr>
                                    <tr>
                                        <td>HX_BCV_OU:</td>
                                        <td>@Model.HX_BCV_OU</td>
                                    </tr>
                                    <tr>
                                        <td>HX_BCV_OS:</td>
                                        <td>@Model.HX_BCV_OS</td>
                                    </tr>
                                    <tr>
                                        <td>Unaided OD</td>
                                        <td>@Model.Unaided_OD</td>
                                    </tr>
                                    <tr>
                                        <td>Unaided OS:</td>
                                        <td>@Model.Unaided_OS</td>
                                    </tr>
                                    <tr>
                                        <td>Unaided_OU</td>
                                        <td>@Model.Unaided_OU</td>
                                    </tr>
                                </table>
                            </div>
                        </div> *@

                        <!-- Summary -->
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <h5>Test Remark</h5>
                            </div>
                            <div class="col-sm-12">
                                <table class="table table-bordered table-striped">
                                    <tr>
                                        <td style="width:30%">Result Outcome:</td>
                                        <td><strong>@Model.PassOrFail</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Recommendation</td>
                                        <td><strong>@EnumHelper.GetEnumDescription(Model.PassResult)</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Pathological Remarks:</td>
                                        <td>@Model.PathologicalRemarks</td>
                                    </tr>
                                    <tr>
                                </table>
                            </div>
                        </div>

                        @* <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <h5>Test Information</h5>
                            </div>
                            <div class="col-sm-12">
                                <table class="table table-bordered table-striped">
                                    <tr>
                                        <td>Test Type:</td>
                                        <td>@EnumHelper.GetEnumDescription(Model.TestType)</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
 *@
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <h5>Test Information</h5>
                            </div>
                            <div class="col-sm-12">
                                <table class="table table-bordered table-striped">
                                    <tr>
                                        <td style="width:30%">Facility:</td>
                                        <td>@Model.OptometristFirmName</td>
                                    </tr>
                                    <tr>
                                        <td>Authenticating Dr:</td>
                                        <td>@Model.OptometristName</td>
                                    </tr>
                                    <tr>
                                        <td>Test Date:</td>
                                        <td>@Model.TestDate.Value.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <button class="btn btn-danger btn-sm" onclick="history.back()">Back</button>
                            </div>
                        </div>
                    </div>


                    <br />
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>


    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
    <script src="~/bootstrapdemos.wrappixel.com/materialpro/dist/assets/libs/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/bootstrapdemos.wrappixel.com/materialpro/dist/assets/js/forms/sweet-alert.init.js"></script>
    <script>
        function VerifyResult(token){
            $.ajax({
                url:'@Url.Action("VerifyResult")?token='+token,
                type:'GET',
                dataType:'json',
                success:function(response){
                    if(response.success){
                        Swal.fire({
                        title: 'Success',
                        text: response.message,
                        type: 'success'
                    }).then(function(){
                        location.reload();
                    });
                    }
                    else{
                        Swal.fire({
                        title: 'Error',
                        text: response.message,
                        type: 'error'
                    });
                    }
                },
                error:function(err){

                }
            });
        }
    </script>


</body>
</html>