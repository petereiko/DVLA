@using DVLA.VerificationPortal.Shared.Requests
@model ChangePasswordRequest
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <!-- ----------------------------------------- -->
        <!-- 1. Basic Form -->
        <!-- ----------------------------------------- -->
        <!-- start Basic Form -->
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Change Password Form</h4>
                <form asp-action="ChangePassword" method="post">

                    @if (Model.Errors.Any())
                    {
                        <div class="row">
                            <div class="col-12">
                                <div class="alert alert-danger">@Model.Errors.FirstOrDefault()</div>
                            </div>
                        </div>
                        <br />
                    }

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" asp-for="OldPassword" placeholder="Current Password" required />
                                <label for="OldPassword">Current Password</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" asp-for="NewPassword" placeholder="New Password" required />
                                <label for="NewPassword">New Password</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" asp-for="ConfirmNewPassword" placeholder="Confirm New Password" required />
                                <label for="ConfirmNewPassword">Confrm New Password</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-md-flex align-items-center">

                                <div class="ms-auto mt-3 mt-md-0">
                                    <button type="submit" class="btn btn-primary hstack gap-6">

                                        Change Password
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>




