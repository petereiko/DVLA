@using DVLA.Data.Models.DataObjects.ViewModels
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
@model ResetPasswordViewModel

<form asp-action="ResetPassword" method="post">
    
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ResetToken"/>
    <div class="mb-4">
        <label for="Password" class="form-label">New Password</label>
        <input type="password" asp-for="Password" class="form-control">
    </div>
    <div class="mb-4">
        <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
        <input type="password" asp-for="ConfirmPassword" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary w-100 py-8 mb-4 ">Reset Password</button>
    <div class="d-flex align-items-center justify-content-center">
        <p class="fs-4 mb-0 fw-medium">Login to your Account?</p>
        <a class="text-primary fw-medium ms-2" asp-action="Login" asp-asp-controller="Account">
            login
        </a>
    </div>
</form>

@section Scripts {
    @if (Model.Errors.Any())
    {
        <script>
            Swal.fire({
                title: 'Error',
                text: '@Model.Errors.FirstOrDefault()',
                type: 'error'
            });
        </script>
    }
}

