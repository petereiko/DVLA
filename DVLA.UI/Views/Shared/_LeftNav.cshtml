                                                    <a asp-action="SlotUsed" asp-controller="SlotManagement" asp-area="Admin" class="sidebar-link sublink">
                                                        <div class="round-16 d-flex align-items-center justify-content-center">
                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Slot Used</span>
                                                    </a>
                                                </li>
