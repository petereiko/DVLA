                                        {
                                            <a asp-action="Index" asp-controller="Dashboard" asp-area="" class="sidebar-link">
                                                <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Dashboard</span>
                                            </a>
                                        }
                                    </li>

                                    <!--Setups-->
