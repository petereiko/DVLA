                                                        <a asp-action="Index" asp-controller="EmailTemplate" asp-area="Admin" class="sidebar-link sublink">
                                                            <div class="round-16 d-flex align-items-center justify-content-center">
                                                                <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                            </div>
                                                            <span class="hide-menu">Email Templates</span>
                                                        </a>
                                                    </li>
                                                    <li class="sidebar-item">
                                                        <a asp-action="Index" asp-controller="SmsTemplate" asp-area="Admin" class="sidebar-link sublink">
                                                            <div class="round-16 d-flex align-items-center justify-content-center">
                                                                <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                            </div>
                                                            <span class="hide-menu">SMS Template</span>
                                                        </a>
                                                    </li>
                                                }
                                                <li class="sidebar-item">
                                                    <a asp-action="SlotPrices" asp-controller="SlotManagement" asp-area="Admin" class="sidebar-link sublink">
                                                        <div class="round-16 d-flex align-items-center justify-content-center">
                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Slot Fee</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </li>
                                    }

                                    <!--User Management-->
                                    @if (User.IsInRole(AppRoles.SYSTEMADMIN) || User.IsInRole(AppRoles.FACILITYOWNER))
