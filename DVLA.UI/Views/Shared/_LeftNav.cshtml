                                        <li class="sidebar-item">
                                            <a class="sidebar-link has-arrow" href="javascript:void(0)" aria-expanded="false">
                                                <iconify-icon icon="solar:sidebar-code-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Slot Mgt.</span>
                                            </a>
                                            <ul aria-expanded="false" class="collapse first-level">
                                                <li class="sidebar-item">
                                                    <a asp-action="SlotRequest" asp-controller="SlotManagement" asp-area="Admin" asp-route-status="@((int)SlotRequestStatus.Pending)" class="sidebar-link sublink">
                                                        <div class="round-16 d-flex align-items-center justify-content-center">
                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Pending Request</span>
                                                    </a>
                                                </li>
                                                <li class="sidebar-item">
                                                    <a asp-action="SlotRequest" asp-controller="SlotManagement" asp-area="Admin" asp-route-status="@((int)SlotRequestStatus.Approved)" class="sidebar-link sublink">
                                                        <div class="round-16 d-flex align-items-center justify-content-center">
                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Approved Request</span>
                                                    </a>
