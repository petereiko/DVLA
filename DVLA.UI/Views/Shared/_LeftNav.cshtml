                                            <a asp-action="Index" asp-controller="AuditManagement" asp-area="Admin" class="sidebar-link sublink">
                                                <div class="round-16 d-flex align-items-center justify-content-center">
                                                    <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                </div>
                                                <span class="hide-menu">Audit Management</span>
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole(AppRoles.FACILITYOWNER) || User.IsInRole(AppRoles.OPTOMETRIST))
                                    {

                                        <li class="sidebar-item">
                                            <a asp-action="Index" asp-controller="VisualAssessmentResult" asp-area="Customer" class="sidebar-link">
                                                <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Eye Test Result</span>
                                            </a>
                                        </li>

                                        @* <li class="sidebar-item">
                                    <a asp-action="SlotReorder" asp-controller="Slot" asp-area="Customer" class="sidebar-link">
                                    <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                    <span class="hide-menu">Access Reorder Level</span>
                                    </a>
                                    </li> *@
                                        <li class="sidebar-item">
                                            <a asp-action="InitiateSlotRequest" asp-controller="Slot" asp-area="Customer" class="sidebar-link">
                                                <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Buy Slots</span>
                                            </a>
                                        </li>
                                        <li class="sidebar-item">
                                            <a asp-action="MyRequests" asp-controller="Slot" asp-area="Customer" class="sidebar-link">
                                                <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Slot History</span>
                                            </a>
                                        </li>
                                        <li class="sidebar-item">
                                            <a asp-action="BiodataUpdate" asp-controller="ReportManagement" asp-area="Customer" class="sidebar-link">
                                                <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                <span class="hide-menu">Biodata Update</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div><div class="simplebar-placeholder" style="width: 260px; height: 3841px;"></div>
            </div><div class="simplebar-track simplebar-horizontal" style="visibility: hidden;"><div class="simplebar-scrollbar" style="width: 0px; display: none;"></div></div><div class="simplebar-track simplebar-vertical" style="visibility: visible;"><div class="simplebar-scrollbar" style="height: 113px; transform: translate3d(0px, 0px, 0px); display: block;"></div></div>
        </nav>

        <!-- End Sidebar scroll-->
    </div>
</aside>
