                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Rejected Request</span>
                                                    </a>
                                                </li>
                                                <li class="sidebar-item">
                                                    <a asp-action="SlotDeduction" asp-controller="SlotManagement" asp-area="Admin" class="sidebar-link sublink">
