                                            <li class="sidebar-item">
                                                <a asp-action="Index" asp-controller="UserManagement" asp-area="Customer" class="sidebar-link">
                                                    <iconify-icon icon="solar:screencast-2-linear" class="aside-icon"></iconify-icon>
                                                    <span class="hide-menu">User Mgt.</span>
                                                </a>
                                            </li>
                                        }
                                    }

