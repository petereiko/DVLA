                                                        </div>
                                                        <span class="hide-menu">Income Report</span>
                                                    </a>
                                                </li>
                                                <li class="sidebar-item">
                                                    <a asp-action="FetchSlotReductionLogs" asp-controller="ReportManagement" asp-area="Admin" class="sidebar-link sublink">
                                                        <div class="round-16 d-flex align-items-center justify-content-center">
                                                            <iconify-icon icon="solar:stop-circle-line-duotone"></iconify-icon>
                                                        </div>
                                                        <span class="hide-menu">Slot Deduction Report</span>
                                                    </a>
                                                </li>

