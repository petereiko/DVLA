    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                title: 'Success',
                text: '@TempData["SuccessMessage"].ToString()',
                type: 'success'
            });
        </script>

        TempData["SuccessMessage"] = null;
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
