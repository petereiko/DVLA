@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.Enumerables
@model VisualAssessmentResultModel
@{
    string result = Model.PassOrFail.ToString();
    string resultServiceType = "";
    if (Model.ResultServiceType.HasValue)
    {
        resultServiceType = EnumHelper<ResultServiceType>.GetDisplayValue(Model.ResultServiceType.Value);
    }
}

<div class="row">
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-8">
                <table>
                    <tr>
                        <td style="padding-right:20px">
                            <img src="@Model.PassportImageUrl" style="width:150px; height:150px" />
                        </td>
                        <td valign="top" style="font-size:12pt; padding:5px; color:#2cabe3;">
                            <div class="col-12" style="text-transform:uppercase">@Model.Surname @Model.FirstName @Model.OtherName</div>
                            <div class="col-12">@Model.DOB.GetValueOrDefault().ToString("dd/MM/yyyy")</div>
                            <div class="col-12">@Model.MobileNumber</div>
                        </td>
                    </tr>
                </table>
            </div>

        </div>
    </div>
    <div class="col-md-4" style="font-family:'Yu Gothic UI'; font-weight:bold; font-size:12pt">
        <div style="float:right">VAS NO: @Model.ReferenceNumber</div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-8">
        <table style="font-size:14pt">
            <tr>
                <td style="padding-right:20px;">Results:</td>
                <td>
                    @result
                </td>
            </tr>
            <tr>
                <td></td>
                <td>
                    @Model.ResultConclusion
                </td>
            </tr>
        </table>
    </div>
    <div class="col-md-4">
        <table>
            <tr>
                <td style="padding-right:30px">Test Facility Details:</td>
                <td><b>@Model.BusinessName</b></td>
            </tr>
            @* <tr>
                <td style="padding-right:30px">Authenticated By:</td>
                <td><b>@Model.Optometrist</b></td>
            </tr> *@
            <tr>
                <td style="padding-right:30px">Service Type:</td>
                <td><b>@resultServiceType</b></td>
            </tr>
            </tr>
        </table>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-8"></div>
    <div class="col-md-4">
        SIGN AND STAMP
    </div>
</div>
<hr />
<div class="row">
    <div class="col-12">
        Disclaimer: Passing this eye exam does not guarantee the applicant a driver's license. The issuance of the license is the sole prerogative of the DVLA.
    </div>
</div>


