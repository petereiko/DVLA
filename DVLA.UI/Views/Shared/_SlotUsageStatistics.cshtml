@using DVLA.Data.Models.DataObjects.ViewModels
@model SlotUsageStatisticsViewModel
<div class="card form-card">
    <div class="card-body">
        <div id="admin-company-dashboard-component">

            <div class="mt-3 d-flex">
                <div class="w-50 mr-2 p-0">
                    <div class="card shadow-lg mb-0 height-400px">
                        <div class="card-body">
                            <h5 class="card-title">Daily</h5>
                            <canvas id="daily-Chart"></canvas>
                        </div>

                    </div>
                </div>
                <div class="w-50 ml-2 p-0">
                    <div class="card shadow-lg mb-0 height-400px">
                        <div class="card-body">
                            <h5 class="card-title">Weekly</h5>
                            <canvas id="weekly-Chart"></canvas>
                        </div>

                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex">
                <div class="w-50 mr-2 p-0">
                    <div class="card shadow-lg mb-0 height-400px">
                        <div class="card-body">
                            <h5 class="card-title">Monthly</h5>
                            <canvas id="monthly-Chart"></canvas>
                        </div>

                    </div>
                </div>
                <div class="w-50 ml-2 p-0">
                    <div class="card shadow-lg mb-0 height-400px">
                        <div class="card-body">
                            <h5 class="card-title">Yearly</h5>
                            <canvas id="yearly-Chart"></canvas>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>


