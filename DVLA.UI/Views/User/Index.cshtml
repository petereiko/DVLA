@using DVLA.Data.Models.DataObjects.UtilityObjects
@using DVLA.Data.Models.DataObjects.ViewModels
@model PaginationResponseModel<List<UserViewModel>>
@{
    ViewData["Title"] = "User";
}

<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            @* <div class="mb-2">
            <h4 class="card-title mb-0">File export</h4>
            </div> *@
            <p class="card-subtitle mb-3">
                <a asp-action="Create" class="btn btn-primary">Create New @ViewData["Title"].ToString()</a>
            </p>
            <div class="table-responsive">
                <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                    <thead>
                        <!-- start row -->
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Action</th>
                        </tr>
                        <!-- end row -->
                    </thead>
                    <tbody>
                        @foreach (UserViewModel item in Model.ListResult)
                        {
                            <!-- start row -->
                            <tr>
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.DefaultRole</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@if (item.EmailConfirmed)
                                    {
                                        <span class="mb-1 badge rounded-pill text-bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="mb-1 badge rounded-pill text-bg-danger">Not Confirmed</span>
                                    }
                                </td>
                                <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                </td>
                            </tr>
                            <!-- end row -->
                        }
                    </tbody>
                </table>
                <div>
                    <span>Records (Page @Model.PageIndex of @Model.TotalPages)</span>
                </div>
                <div class="pagination">
                    <ul class="pagination">
                        @if (Model.PageIndex > 1)
                        {
                            <li><a href="@Url.Action("Index", new { pageIndex = Model.PageIndex - 1 })">Previous</a></li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="@(i == Model.PageIndex ? "active" : "")">
                                <a class="btn btn-sm btn-primary" href="@Url.Action("Index", new { pageIndex = i })">@i</a>
                            </li>
                        }

                        @if (Model.PageIndex < Model.TotalPages)
                        {
                            <li><a href="@Url.Action("Index", new { pageNumber = Model.PageIndex + 1 })">Next</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
</div>

