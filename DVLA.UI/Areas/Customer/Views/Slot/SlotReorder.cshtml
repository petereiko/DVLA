@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data
@model IEnumerable<SlotModel>

@{
    ViewBag.Title = "Slot Reorder Level";
    int i = 0;
}


<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">Visual Assessment Results</h4>
            </div>
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">



                        <div class="table-responsive">


                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>Access Type</th>
                                        <th>Reorder Level</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        i = i + 1;
                                        <tr>
                                            <td>@i</td>
                                            <td>
                                                @(item.AccessType == 0 ? "" : item.AccessType.GetDisplayName())
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ReorderLevel)
                                            </td>
                                            <td style="text-align:right;">
                                                <a asp-action="UpdateSlotReOrder" asp-controller="Slot" asp-route-token="@Utility.Encrypt(item.Id.ToString())" class="btn btn-primary">Edit</a>
                                                
                                            </td>
                                        </tr>

                                    }

                                </tbody>

                            </table>






                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>








