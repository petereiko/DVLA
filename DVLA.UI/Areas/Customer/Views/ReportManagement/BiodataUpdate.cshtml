@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.DataObjects.UtilityObjects
@using DVLA.Data.Models.DataObjects.ViewModels
@model PaginationResponseModel<List<VisualAssessmentResultItemViewModel>>
@{
    ViewBag.Title = "Biodata Update";
    ViewData["Area"] = "customer";
    int counter = 0;
}


<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">Biodata Update</h4>
            </div>
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">

                        <form asp-action="BiodataUpdate" asp-controller="ReportManagement" method="post">

                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control mydatepicker" value="@ViewBag.StartDate" id="StartDate" name="StartDate" autocomplete="off" placeholder="Enter Start Date" data-date-format="dd/mm/yyyy" />
                                        <label for="StartDate">Start Date</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control mydatepicker" value="@ViewBag.EndDate" autocomplete="off" id="EndDate" name="EndDate" placeholder="Enter End Date" data-date-format="dd/mm/yyyy" />
                                        <label for="EndDate">End Date</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <br />
                                    Show
                                    <select id="Entries" name="Entries">
                                        @if (ViewBag.Entries == "10")
                                        {
                                            <option selected value="10">10</option>
                                        }
                                        else
                                        {
                                            <option value="10">10</option>
                                        }
                                        @if (ViewBag.Entries == "20")
                                        {
                                            <option selected value="20">20</option>
                                        }
                                        else
                                        {
                                            <option value="20">20</option>
                                        }
                                        @if (ViewBag.Entries == "50")
                                        {
                                            <option selected value="50">50</option>
                                        }
                                        else
                                        {
                                            <option value="50">50</option>
                                        }
                                        @if (ViewBag.Entries == "100")
                                        {
                                            <option selected value="100">100</option>
                                        }
                                        else
                                        {
                                            <option value="100">100</option>
                                        }
                                        @if (ViewBag.Entries == "101")
                                        {
                                            <option selected value="1000000"> > 100</option>
                                        }
                                        else
                                        {
                                            <option value="1000000"> > 100</option>
                                        }
                                    </select>
                                    entries
                                </div>
                                <div class="col-3">
                                    <div class="d-md-flex align-items-center">

                                        <div class="ms-auto mt-3 mt-md-0">
                                            <button type="submit" class="btn btn-primary hstack gap-6">
                                                Search
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <br />

                        <div class="table-responsive">
                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th class="width-10px text-center">#</th>
                                        <th>Names</th>
                                        <th>Address</th>
                                        <th>Company</th>
                                        <th>DS Reference</th>
                                        <th>Test Date</th>
                                        <th>Grade</th>
                                        <th></th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ListResult)
                                    {
                                        counter = counter + 1;
                                        <tr>
                                            <td>
                                                @counter
                                            </td>
                                            <td><span>@item.ApplicantName </span></td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ApplicantAddress)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.OptometristFirmName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.DSReference)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.TestDate)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ResultConclusion)
                                            </td>

                                            <td>
                                                
                                                <div class="dropdown">
                                                    <div class="btn-group">
                                                        <button class="btn btn-primary dropdown-toggle show" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="true">
                                                            Action
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton" data-popper-placement="bottom-start" style="position: absolute; inset: 0px auto auto 0px; margin: 0px; transform: translate3d(0px, 40.8px, 0px);">
                                                            <li>
                                                                <a asp-action="Detail" asp-controller="VisualAssessmentResult" asp-area="Customer" asp-route-page="Details" asp-route-token="@Utility.Encrypt(item.Id.ToString())">Details</a>
                                                            </li>
                                                            <li>
                                                                <a asp-action="Update" asp-controller="ReportManagement" asp-route-token="@Utility.Encrypt(item.Id.ToString())">Update</a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @{
                                PaginationModel paginationModel = new()
            {
                Action = "BiodataUpdate",
                Area = "Customer",
                Controller = "ReportManagement",
                EndIndex = Model.EndIndex,
                FilteredCount = Model.ListResult.Count,
                PageIndex = Model.PageIndex,
                TotalCount = Model.TotalCount,
                TotalPages = Model.TotalPages
            };
                            }

                            @* <partial name="_PaginationFooter" model="paginationModel" /> *@


                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {

    <script>
        $(function () {
            // $('#file_export_info').hide();
            // $('#file_export_paginate').hide();
            // $('#dataTables_info').hide();
        });
    </script>
}