@using DVLA.Data
@using DVLA.Data.Models.DataObjects.ViewModels
@model IEnumerable<UserViewModel>
@{

    ViewBag.Title = "User";
    var i = 0;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            @* <div class="mb-2">
            <h4 class="card-title mb-0">File export</h4>
            </div> *@
            <p class="card-subtitle mb-3">
                <a asp-action="Create" asp-controller="UserManagement" asp-area="Customer" class="btn btn-primary">Create New @ViewData["Title"].ToString()</a>
            </p>
            <div class="table-responsive">
                <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                First Name
                            </th>
                            <th>
                                Last Name
                            </th>
                            <th>
                                Mobile Number
                            </th>
                            <th>
                                Email Address
                            </th>
                            <th>
                                Status
                            </th>
                            <th></th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            i = i + 1;
                            <tr>
                                <td>
                                    @i
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FirstName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LastName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.MobileNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="mb-1 badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="mb-1 badge text-bg-danger">Inactive</span>
                                    }

                                </td>
                                @{
                                    var toggleActive = item.IsActive ? "Disable" : "Enable";
                                }
                                <td style="text-align:right;">
                                    <div class="dropdown">
                                        <div class="btn-group">
                                            <button class="btn btn-primary dropdown-toggle show" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="true">
                                                Action
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton" data-popper-placement="bottom-start" style="position: absolute; inset: 0px auto auto 0px; margin: 0px; transform: translate3d(0px, 40.8px, 0px);">
                                                <li>
                                                    <a asp-action="Update" asp-route-Id="@item.Id" class="dropdown-item">Update</a>
                                                </li>
                                                <li>
                                                    <a onclick="ChangeStatus(@item.Id)" class="dropdown-item">@toggleActive</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>





<!-- MODAL -->
<div id="divModal">
    @*@Html.Partial("_ManageOptometrist", new DVLA.DATA.Models.OptometristFirmModel())*@
</div>
@section Scripts {
    <script>
        $("#btnSearch").click(function () {
            var roleId = $('#RoleId').val()
            var name = $('#Name').val();
            Search(roleId, name);
        })


        function changeUserStatus(Id) {

            $.ajax({
                type: "POST",
                url: '/UserManagement/ChangeStatus',
                dataType: "json",
                processData: false,
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ Id: Id }),
                success: function (response) {
                    console.log(response);

                    if (response.success) {
                        swal(
                            'Success',
                            response.message,
                            'success'
                        );
                        setTimeout(function () {
                            location.reload();
                        }, 1200);
                    }
                    else {
                        swal(
                            'Error!',
                            response.message,
                            'error'
                        )
                    }
                },
                error: function (err) {
                    console.log(err);
                }
            });
        }

        function resetPassword(Id) {

            $.ajax({
                type: "POST",
                url: '/UserManagement/ResetPassword',
                dataType: "json",
                processData: false,
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ Id: Id }),
                success: function (response) {
                    console.log(response);

                    if (response.success) {
                        swal(
                            'Success',
                            response.message,
                            'success'
                        );
                        setTimeout(function () {
                            location.reload();
                        }, 1200);
                    }
                    else {
                        swal(
                            'Error!',
                            response.message,
                            'error'
                        )
                    }
                },
                error: function (err) {
                    console.log(err);
                }
            });
        }

    </script>
}
