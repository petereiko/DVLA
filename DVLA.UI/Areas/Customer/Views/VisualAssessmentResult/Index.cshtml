@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.DataObjects.UtilityObjects
@using DVLA.Data.Models.DataObjects.ViewModels
@using DVLA.Data.Models.Enumerables
@model PaginationResponseModel<List<VisualAssessmentResultListItem>>

@{
    ViewBag.Title = "Eye Test Results";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var i = 0;
}
<link href="~/cdn.datatables.net/jquerydatatable/datatable.css" rel="stylesheet" />

<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            @* <div class="mb-2">
            <h4 class="card-title mb-0">File export</h4>
            </div> *@

            <form asp-action="Index" asp-controller="VisualAssessmentResult" method="post">

                <div class="row">
                    <div class="col-md-2">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control mydatepicker" value="@ViewBag.StartDate" id="StartDate" name="StartDate" autocomplete="off" placeholder="Enter Start Date" data-date-format="dd/mm/yyyy" />
                            <label for="StartDate">Start Date</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control mydatepicker" value="@ViewBag.EndDate" autocomplete="off" id="EndDate" name="EndDate" placeholder="Enter End Date" data-date-format="dd/mm/yyyy" />
                            <label for="EndDate">End Date</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" value="@ViewBag.DSReference" autocomplete="off" id="DSReference" name="DSReference" placeholder="DS Reference" />
                            <label for="DSReference">DS Reference</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-floating mb-3">
                            <select id="Status" name="Status" class="form-control">
                                @foreach (SelectListItem item in Html.GetEnumSelectList<Status>())
                                {
                                    if (ViewBag.Status.ToString() == item.Text)
                                    {
                                        <option selected value="@item.Value">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                            <label for="Status">Status</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <br />
                        Show
                        <select id="Entries" name="Entries">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="100000"> >100 </option>
                        </select>
                        entries
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="d-md-flex align-items-center">

                            <div class="ms-auto mt-3 mt-md-0">
                                <button type="submit" class="btn btn-primary hstack gap-6">
                                    Search
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">

                        <partial name="_Upload" , model="new VisualAssessmentResultUploadViewModel()" />
                        <div class="d-flex mb-2 float-right">

                            <div class="d-flex">
                                <p class="card-subtitle mb-3">
                                    <a asp-action="Create" asp-controller="VisualAssessmentResult" asp-area="Customer" class="btn btn-primary">Create New @ViewData["Title"].ToString()</a>

                                    @* <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bs-example-modal-md">
                                        Upload
                                    </button> *@
                                </p>
                            </div>


                        </div>

                        <br />
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">@TempData["SuccessMessage"].ToString()</div>
                        }

                        <div class="table-responsive">
                            @* <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap"> *@
                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Reference #
                                        </th>
                                        <th>
                                            Service Type
                                        </th>
                                        <th>
                                            Full Name
                                        </th>
                                        <th>
                                            Test Date
                                        </th>
                                        <th>
                                            Status
                                        </th>
                                        <th></th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ListResult)
                                    {
                                        i = i + 1;
                                        <tr>
                                            <td>
                                                @i
                                            </td>
                                            <td>
                                                @if (item.Status == Status.Complete)
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-success">@item.ReferenceNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-info">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    string serviceType = "N/A";
                                                    if (item.ResultServiceType != null)
                                                    {
                                                       serviceType = DVLA.Data.EnumHelper<ResultServiceType>.GetDisplayValue(item.ResultServiceType.Value);
                                                    }
                                                }
                                                <span>@serviceType</span>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Surname) @Html.DisplayFor(modelItem => item.FirstName)
                                            </td>



                                            <td>
                                                @if (item.TestDate.HasValue)
                                                {
                                                    <span>@item.TestDate.Value.ToString("dd-MMM-yyyy")</span>
                                                }
                                            </td>

                                            <td>
                                                @if (item.Status == Status.Complete)
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-success">Complete</span>
                                                }
                                                else
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-info">In Progress</span>
                                                }
                                            </td>
                                            <td style="text-align:right;">



                                                @if (item.Status == Status.InProgress)
                                                {
                                                    <a class="btn btn-primary mb-2 btn-sm" id="btnProcess" href="@Url.Action("Create", "VisualAssessmentResult", new { page="Details", token=Utility.Encrypt(item.Id.ToString()) })">Modify Result</a>

                                                }

                                                @if (item.Status == Status.Complete)
                                                {
                                                    <a class="btn btn-primary mb-2 btn-sm" id="btnProcess" href="@Url.Action("Detail", "VisualAssessmentResult", new { page="Details", token=Utility.Encrypt(item.Id.ToString()) })">View Result</a>

                                                }

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/cdn.datatables.net/jquerydatatable/datatable.js"></script>
@section Scripts {
    <script>

        $('#mytable').dataTable();

        function ShowModal() {
            $('#myModal').show();
        }
    </script>
}








