@using DVLA.Data
@using DVLA.Data.Models.DataObjects.ViewModels
@using DVLA.Data.Models.Enumerables
@using Microsoft.Extensions.Configuration
@inject IConfiguration _config;
@{
    ViewBag.Title = "Eye Test Results";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int passportMaxSize = Convert.ToInt32(_config["AppConstants:PassportMaxSize"]);
}
@model VisualAssessmentResultViewModel
<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">Eye Test Results</h4>
            </div>
            <div id="DivIdToPrint">
                <div class="card form-card">
                    <div class="card-body">

                        <div class="container">
                            <br />
                            <div id="loading" style="display: none;">
                                <table style="height: 100%; border: 0; width: 100%; position: fixed; top: 0; left: 0; background-color: #FAFAFA; opacity: 0.8; filter: alpha(opacity=80); z-index: 9000;">
                                    <tbody>
                                        <tr>
                                            <td style="width: 100%; text-align:center; vertical-align : middle;">
                                                <div id="Loadingtext" style="font-family: Arial; font-size: 24px; opacity: 1; filter: alpha(opacity=100); font-weight: bold; color: #000000; text-align: center; padding-top: 5px;"><img src="//i.stack.imgur.com/FhHRx.gif" />&nbsp;Please wait...</div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="row">
                                <div class="col-sm-4" style="padding:0px">
                                    <video id="video" autoplay style="height: 200px;clip-path: inset(0px 20px 0px 20px); border:1px solid black"></video>
                                    <button onclick="Capture()" style="margin-left:20px" id="capture" class="btn btn-primary">Capture</button>
                                    @Html.ValidationMessageFor(model => model.PassportImageUrl, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-sm-4" style="padding:0px">
                                    <canvas id="canvas" width="200" height="200" />
                                    <img src="" hidden id="photo" style="height: 200px; width:200px; border:1px solid black" />
                                </div>
                                <div class="col-sm-4" style="padding:0px">
                                    @if (!string.IsNullOrEmpty(Model.PassportImageUrl))
                                    {
                                        <img src="/Passports/@Model.PassportImageUrl" id="photo1" style="height: 200px; width:200px;" />
                                    }
                                </div>

                            </div>
                        </div>
                        <br />
                        <form method="post" id="target" asp-action="Create" enctype="multipart/form-data" asp-controller="VisualAssessmentResult" asp-area="Customer" asp-route-token="@ViewBag.Token">
                            <div class="container">
                                @if (Model.Errors.Any())
                                {
                                    <div class="alert alert-danger">@Model.Errors.FirstOrDefault()</div>
                                }


                                <div class="row">
                                    <div class="col-sm-4">
                                        <label>Upload Image <strong style="color:red">(Max Passport Size @passportMaxSize KB)</strong></label>
                                        <div style="margin-bottom:0px !important; padding-bottom:0px !important;">
                                            @Html.TextBoxFor(m => m.Image, new { @class = "form-control", type = "file", accept = "image/jpeg" })
                                            @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <img src="" id="passportpreview" style="height: 200px; width:200px; display:none" />
                                    </div>
                                </div>




                            </div>



                            <input type="hidden" asp-for="PassportImageUrl" />
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ActionType" />
                            <input type="hidden" asp-for="Action" />
                            <input type="hidden" asp-for="Status" />
                            <input type="hidden" asp-for="ReferenceNumber" />
                            <input type="hidden" asp-for="OptometristFirmId" />
                            <input type="hidden" asp-for="PassportUploadType" value="" />


                            <div class="container">
                                <br />
                                <div id="ServiceTypeArea">
                                    <ul class="nav nav-tabs" id="ServiceTypeTab">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab">Service Type</a>
                                        </li>

                                    </ul>
                                </div>
                                <br />
                                <div class="row row-xs mg-b-10">


                                    <div class="col-4">
                                        Service Type
                                        <select asp-for="ResultServiceType" class="form-control" asp-items="Html.GetEnumSelectList<ResultServiceType>()" required>
                                            <option>Select Service Type</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.ResultServiceType, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-4">

                                        @if (Model.ResultServiceType == ResultServiceType.RenewalOfDriverLicence || Model.ResultServiceType == ResultServiceType.AccidentReport || Model.ResultServiceType == ResultServiceType.UpgradeOfDriverLicence || Model.ResultServiceType == ResultServiceType.ReplacementOfDriverLicence)
                                        {
                                            <div id="dvla-licensenumber-area">
                                                <span>DVLA License Number</span>
                                                <input type="text" class="form-control" asp-for="DvlaLicenseNumber" />
                                                @Html.ValidationMessageFor(Model => Model.DvlaLicenseNumber, "", new { @class = "text-danger" })
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="display:none" id="dvla-licensenumber-area">
                                                <span>DVLA License Number</span>
                                                <input type="text" class="form-control" asp-for="DvlaLicenseNumber" />
                                                @Html.ValidationMessageFor(Model => Model.DvlaLicenseNumber, "", new { @class = "text-danger" })
                                            </div>
                                        }



                                    </div>
                                </div>
                                <br />
                                <div id="DetailsOfApplicant">
                                    <ul class="nav nav-tabs" id="DetailsOfApplicantTab">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab">Details of Applicant</a>
                                        </li>

                                    </ul>
                                    <br />
                                    <div class="tab-content mb-4">
                                        <div class="tab-pane active" id="DetailsTab">

                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    Surname
                                                    <input asp-for="Surname" class="form-control" autocomplete="off" required />
                                                    @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    First Name
                                                    <input asp-for="FirstName" class="form-control" autocomplete="off" required />
                                                    @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                    Other Name
                                                    <input asp-for="OtherName" class="form-control" autocomplete="off" />
                                                </div>
                                                <div class="col-sm">
                                                    Date of Birth (DD/MM/YYYY)
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" asp-for="DOB" autocomplete="off" data-date-format="dd/mm/yyyy" />
                                                        <div class="input-group-addon">
                                                            <span class="glyphicon glyphicon-th"></span>
                                                        </div>
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger" })
                                                    @Html.HiddenFor(model => model.DateOfBirth)
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm-4">
                                                    Gender

                                                    <select asp-for="Gender" class="form-control" required asp-items="@Html.GetEnumSelectList<Gender>()">
                                                        <option value="">--Select Gender--</option>
                                                    </select>
                                                    @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                                                </div>

                                                <div class="col-sm-4">
                                                    Digital/Residential Address
                                                    @* <input type="text" asp-for="PostalAddress" class="form-control" /> *@
                                                    <textarea class="form-control" asp-for="PostalAddress" rows="1"></textarea>
                                                    @Html.ValidationMessageFor(model => model.PostalAddress, "", new { @class = "text-danger" })
                                                </div>

                                                @* <div class="col-sm-8">
                                                    Digital/Residential Address
                                                    <div class="input-group">
                                                        <input type="text" asp-for="PostalAddress" class="form-control" />
                                                        @Html.ValidationMessageFor(model => model.PostalAddress, "", new { @class = "text-danger" })
                                                    </div>
                                                </div> *@

                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    Contact Number
                                                    @Html.TextBoxFor(model => model.ContactNumber, new { @class = "form-control", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.ContactNumber, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    Nationality
                                                    <select asp-for="Nationality" class="form-control" asp-items="@((List<SelectListItem>)ViewBag.Countries)">
                                                        <option value="">--Select Nationality--</option>
                                                    </select>
                                                    @Html.ValidationMessageFor(model => model.Nationality, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    Email (if applicable)
                                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @autocomplete = "off" })

                                                </div>

                                                <div class="col-sm">
                                                    <input type="hidden" asp-for="IdentityType" />
                                                    <div id="identity-number-area" style="display:none">
                                                        <label id="identity-number-label">Ghana Card Number</label>
                                                        <input type="text"
                                                               id="identity-number-input"
                                                               class="form-control"
                                                               value="@(string.IsNullOrEmpty(Model.GhanaCardNumber) ? Model.PassportNumber : Model.GhanaCardNumber)"
                                                               autocomplete="off" />
                                                        <span asp-validation-for="GhanaCardNumber" class="text-danger"></span>
                                                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <div class="col-sm">
                                                    Invoice Number
                                                    @Html.TextBoxFor(model => model.InvoiceNumber, new { @class = "form-control", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.InvoiceNumber, "", new { @class = "text-danger" })

                                                </div>

                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <div id="ImportPermit">
                                    <ul class="nav nav-tabs" id="ImportPermitApplicationTab">
                                        <li class="nav-item">
                                            <a class="nav-link active" href="#DetailsTab" data-toggle="tab">Visual Tests</a>
                                        </li>

                                    </ul>
                                    <br />
                                    <div class="tab-content mb-4">
                                        <div class="tab-pane active" id="DetailsTab">
                                            <div class="row">
                                                <div class="col-sm mt-2">
                                                    <h5>1.	VISUAL ACUITY (Required)</h5>
                                                    <hr />

                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    UNAIDED OD
                                                    @Html.DropDownList("Unaided_OD", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.Unaided_OD, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    UNAIDED OS
                                                    @Html.DropDownList("Unaided_OS", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.Unaided_OS, "", new { @class = "text-danger" })

                                                </div>
                                                @* <div class="col-sm mg-t-10 mg-sm-t-0">
                                                UNAIDED OU
                                                @Html.DropDownList("Unaided_OU", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Unaided_OU, "", new { @class = "text-danger" })

                                                </div> *@

                                            </div>

                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    BCV OD
                                                    @Html.DropDownList("BCV_OD", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.BCV_OD, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    BCV OS
                                                    @Html.DropDownList("BCV_OS", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.BCV_OS, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                    BCV OU
                                                    @Html.DropDownList("BCV_OU", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.BCV_OU, "", new { @class = "text-danger" })

                                                </div>

                                            </div>
                                            <div class="row">
                                                <div class="col-sm mt-2">
                                                    <h5>2.	VISUAL FIELD (Required)</h5>
                                                    <hr />
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    HX BCV OD°
                                                    @Html.DropDownList("HX_BCV_OD", (SelectList)ViewBag.VisualFieldScores, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.HX_BCV_OD, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    HX BCV OS°
                                                    @Html.DropDownList("HX_BCV_OS", (SelectList)ViewBag.VisualFieldScores, "", new { @style = "width:100%;", @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.HX_BCV_OS, "", new { @class = "text-danger" })

                                                </div>
                                                @*<div class="col-sm mg-t-10 mg-sm-t-0">
                                                HX BCV OU°
                                                <div class="form-control">
                                                <span id="HX_BCV_OU">
                                                OD + OS
                                                </span>
                                                </div>
                                                </div>*@

                                                <script>
                                                    function Compute() {
                                                    debugger;
                                                    var left = document.getElementById('HX_BCV_OD').value;
                                                    var right = document.getElementById('HX_BCV_OS').value;
                                                    console.log('!isNaN(left) = ' + !isNaN(left));
                                                    console.log('!isNaN(right) = ' + !isNaN(right));
                                                    if (left != "" && right != "") {
                                                    var result = parseInt(left) + parseInt(right);
                                                    document.getElementById('HX_BCV_OU').innerHTML = result.toString();
                                                    }
                                                    else {
                                                    document.getElementById('HX_BCV_OU').innerHTML = " ";
                                                    }
                                                    }
                                                </script>

                                            </div>
                                            <div class="row">
                                                <div class="col-sm mt-2">
                                                    <h5>3.	CONTRAST SENSITIVITY (Optional)</h5>
                                                    <hr />
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    SINGLE IMAGE (BCV) OU
                                                    @Html.DropDownList("SingleImage_BCV_OU", (SelectList)ViewBag.SingleImage, "", new { @style = "width:100%;", @class = "form-control" })

                                                </div>
                                                <div class="col-sm">
                                                </div>
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                </div>

                                            </div>

                                            @*<div class="row row-xs mg-b-10 mt-2">

                                            <div class="col-sm">
                                            <h5>4.	CONTRAST SENSITIVITY BCV (Optional) </h5>
                                            <hr />
                                            @Html.TextAreaFor(model => model.ContrastSensitivity_BCV, new { @class = "form-control", @placeholder = "Please type in your observation(s)" })

                                            </div>

                                            </div>*@
                                            <div class="row">
                                                <div class="col-sm mt-2">
                                                    <h5>4.	GLARE TEST (Optional)</h5>
                                                    <hr />
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                @*<div class="col-sm">
                                                BCV OD
                                                @Html.DropDownList("GlareTest_BCV_OD", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })

                                                </div>
                                                <div class="col-sm">
                                                BCV OS
                                                @Html.DropDownList("GlareTest_BCV_OS", (SelectList)ViewBag.VisualAcuity, "", new { @style = "width:100%;", @class = "form-control" })
                                                </div>*@
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                    BCV OU
                                                    @Html.DropDownList("GlareTest_BCV_OU", (SelectList)ViewBag.SingleImage, "", new { @style = "width:100%;", @class = "form-control" })
                                                </div>

                                            </div>
                                            <div class="row">
                                                <div class="col-sm mt-2">
                                                    <h5>5.	COLOUR VISION (Optional)</h5>
                                                    <hr />
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    BCV OU

                                                    @Html.DropDownList("ColourVision_BCV_OU", (SelectList)ViewBag.ColourVisionScores, "", new { @style = "width:100%;", @class = "form-control" })

                                                </div>
                                                <div class="col-sm">
                                                </div>
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                </div>

                                            </div>

                                            <div class="row row-xs mg-b-10 mt-2">

                                                <div class="col-sm">
                                                    <h5>6.	PATHOLOGICAL REMARKS (Required)</h5>
                                                    <hr />
                                                    @Html.TextAreaFor(model => model.PathologicalRemarks, new { @class = "form-control", @placeholder = "Please type in your observation(s):" })
                                                    @Html.ValidationMessageFor(model => model.PathologicalRemarks, "", new { @class = "text-danger" })

                                                </div>

                                            </div>
                                            <div class="row row-xs mg-b-10 mt-2">

                                                <div class="col-sm">
                                                    <h5>7.	RESULTS CONCLUSION (Required)</h5>
                                                    <hr />
                                                    <select onchange="ChangeResultConclusion(this)" asp-for="ResultConclusion" asp-items="(SelectList)ViewBag.ResultConclusions" style="width:100%;" class="form-control">
                                                        <option value="">--Select Conclusion--</option>
                                                    </select>
                                                    @Html.ValidationMessageFor(model => model.ResultConclusion, "", new { @class = "text-danger" })

                                                    @* @Html.DropDownListFor(model => model.ResultConclusion, (SelectList)ViewBag.ResultConclusions, "", new { @style = "width:100%;", @class = "form-control" }) *@
                                                </div>

                                            </div>
                                            <div class="row row-xs mg-b-10">
                                                <div class="col-sm">
                                                    <h5>8. RESULTS BASED ON CONCLUSION(S) ABOVE  (Required)</h5>
                                                    <hr />
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <input type="hidden" asp-for="PassOrFailInt" />

                                                <div class="col-sm">
                                                    <select asp-for="PassOrFail" disabled class="form-control" asp-items="Html.GetEnumSelectList<PassOrFail>()">
                                                        <option value="">Select pass type</option>
                                                    </select>
                                                    @* @Html.DropDownList("PassOrFail", EnumHelper.GetSelectList(typeof(PassOrFail)), "", new { @style = "width:100%;", @class = "form-control" }) *@
                                                    @Html.ValidationMessageFor(model => model.PassOrFail, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    @if (Model.ResultConclusion == null)
                                                    {
                                                        <select asp-for="PassResult" style="display:none" asp-items="EnumExtensions.GetEnumSelectListWithDescriptions<PassResult>()" class="form-control">
                                                            <option value="">Select Pass Result</option>
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        if (Model.PassOrFail == PassOrFail.Pass)
                                                        {
                                                            <select asp-for="PassResult" asp-items="EnumExtensions.GetEnumSelectListWithDescriptions<PassResult>()" class="form-control">
                                                                <option value="">Select Pass Result</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <select asp-for="PassResult" style="display:none" asp-items="EnumExtensions.GetEnumSelectListWithDescriptions<PassResult>()" class="form-control">
                                                                <option value="">Select Pass Result</option>
                                                            </select>
                                                        }
                                                    }
                                                    @Html.ValidationMessageFor(model => model.PassResult, "", new { @class = "text-danger" })

                                                </div><div class="col-sm"></div><div class="col-sm"></div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 mb-2">
                                        <div class="row">
                                            <div class="col-lg-6 text-left">
                                                <a href="@Url.Action("Index", "VisualAssessmentResult")" class="btn btn-secondary">Back to Application List</a>


                                            </div>
                                            <div class="col-lg-6 text-right">

                                                <input type="submit" id="btnSave" onclick="PreSubmit()" class="btn btn-primary" value="Save & Continue" />
                                                <input type="submit" onclick="PreSubmit()" id="btnSubmit" class="btn btn-primary" value="Finalize & Submit" />

                                                @* @if (Model == null)
                                                {

                                                    <input type="submit" id="btnSave" class="btn btn-primary" value="Save & Continue" />
                                                    <input type="submit" id="btnSubmit" class="btn btn-primary" value="Finalize & Submit" />

                                                }
                                                else
                                                {
                                                    if (Model.Status == Status.InProgress || Model.Status == null)
                                                    {

                                                        <input type="submit" id="btnSave" class="btn btn-primary" value="Save & Continue Later" />
                                                        <input type="submit" id="btnSubmit" class="btn btn-primary" value="Finalize & Submit" />
                                                    }
                                                    else if(Model.Status==Status.Complete)
                                                    {
                                                        <button onclick="printDiv()" type="button" class="btn btn-primary">Print Result</button>
                                                    }
                                                } *@
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{

    <script src="~/createvisualassessment.js" asp-append-version="true"></script>

    <script>
        function PreSubmit(){
        }

        $(function(){
            $('#ResultServiceType').change(function(){
                let serviceType=$(this).val();

                serviceType=Number(serviceType);
                if(serviceType===2||serviceType===3||serviceType===4||serviceType===5){
                    $('#dvla-licensenumber-area').show();
                }
                else{
                    $('#dvla-licensenumber-area').hide();
                }

            });

            function updateIdentityNumberInput() {
                const nationality = ($('#Nationality').val() || '').toLowerCase();
                const isGhanaian = nationality === 'ghana' || nationality === 'ghanaian';
                const hasNationality = nationality.length > 0;
                const input = $('#identity-number-input');

                $('#identity-number-area').toggle(hasNationality);

                if (isGhanaian) {
                    $('#identity-number-label').text('Ghana Card Number');
                    $('#IdentityType').val('@((int)IdentityType.NationalIDCard)');
                    input.attr('name', 'GhanaCardNumber');
                    input.attr('placeholder', 'Enter your Ghana Card Number');
                } else {
                    $('#identity-number-label').text('Passport Number');
                    $('#IdentityType').val('@((int)IdentityType.InternationalPassport)');
                    input.attr('name', 'PassportNumber');
                    input.attr('placeholder', 'Enter your Passport Number');
                }

                input.prop('required', hasNationality);
            }

            $('#Nationality').change(updateIdentityNumberInput);
            updateIdentityNumberInput();
        })
    </script>
}
