@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.Enumerables

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string token = Context.Request.Query["token"];

    string result = Model.PassOrFail == null ? "" : Model.PassOrFail.ToString();
    string resultServiceType = "";
    if (Model.ResultServiceType.HasValue)
    {
        resultServiceType = EnumHelper<ResultServiceType>.GetDisplayValue(Model.ResultServiceType.Value);
    }

    string action = TempData["Action"] == null ? "#" : TempData["Action"].ToString();

}
@model VisualAssessmentResultModel

<style>
    hr {
        border: 1px solid black
    }
</style>
<div>
    <a asp-action="Create" asp-controller="VisualAssessmentResult" asp-area="Customer" class="btn btn-primary btn-sm left">New Assessment Result</a>
    <button id="btn-print" onclick="PrintDocument()" type="button" class="btn btn-success btn-sm right">Print</button>
</div>
<br />
<div class="datatables">
    <div class="card">
        <div class="card-body">
            
            <center>
                <div id="DivIdToPrint" style="background-image: url('/logos/Dvlalogo_reportwatermark.png') !important; background-repeat:no-repeat !important;background-size: contain !important;background-position: center !important">
                    <table style="width:85%">
                        <tr>
                            <td style="width:20%">
                                <img src="@Model.PassportImageUrl" style="width:80%" />
                            </td>
                            <td style="padding:10px; text-transform:uppercase; vertical-align:text-top; font-size:15pt">
                                <div>@Model.Surname @Model.FirstName @Model.OtherName</div>
                                <div>@Model.DOB.GetValueOrDefault().ToString("dd/MM/yyyy")</div>
                                <div>@Model.ContactNumber</div>
                            </td>
                            <td style="vertical-align:text-top; text-align:right">
                                <img src="~/logos/ODDVLAFullcolor.png" width="70" />
                                <img src="~/logos/GOA.png" width="100" />
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <hr />
                            </td>
                            <td style="text-align:left; font-size:15pt"><strong>OP NO: @Model.ReferenceNumber</strong></td>
                        </tr>
                        <tr>
                            <td style="width:25%">
                                <table>
                                    <tr>
                                        <td>Result:</td>
                                        <td style="padding:5px"><strong>@Model.PassOrFail</strong></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td style="padding:5px"><strong>@Model.ResultConclusion</strong></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>Test Facility Details:</td>
                            <td colspan="2" style="text-transform:uppercase"><strong>@Model.BusinessName</strong></td>
                        </tr>
                        <tr>
                            <td>Authenticated By:</td>
                            <td colspan="2" style="text-transform:uppercase"><strong>@ViewBag.Optometrist</strong></td>
                        </tr>
                        <tr>
                            <td>Service Type:</td>
                            <td style="text-transform:uppercase"><strong>@(EnumHelper<ResultServiceType>.GetDisplayValue(Model.ResultServiceType.GetValueOrDefault()))</strong></td>
                        </tr>
                        <tr>
                            <td colspan="3"><hr /></td>
                        </tr>
                        <tr>
                            <td>SIGN AND STAMP</td>
                            <td colspan="2" style="text-align:right">
                                Test Date: @Model.TestDate.GetValueOrDefault().ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                        @if (Model.TestExpiryDate.HasValue)
                        {
                            <tr>
                                <td></td>
                                <td colspan="2" style="text-align:right">
                                    Test Expiry Date: @Model.TestExpiryDate.Value.ToString("dd/MM/yyyy")
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3"><hr /></td>
                        </tr>
                        <tr>
                            <td colspan="3">
                                Disclaimer: Passing this eye exam does not guarantee the applicant a driver's license. The issuance of the license is the sole prerogative of the DVLA.
                            </td>
                        </tr>
                    </table>
                </div>
            </center>
        </div>
    </div>
</div>



