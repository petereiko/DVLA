                                        <div class="media tx-primary">
                                            <i class="icon ion-ios-analytics"></i>

                                            <div class="media-body">
                                                <h1 class="text-primary" id="_musedSlotsOthers"></h1>
                                                <p><b>Utilized Access</b></p>
                                                <p>Other Licences</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="card card-status bg-teal text-white border-0 shadow-lg">
                                        <div class="media">
                                            <i class="icon ion-thumbsup"></i>
                                            <div class="media-body">
                                                <h1 class="text-white" id="_mapprovedApplications"></h1>
                                                <p>Approved Requests</p>
                                                <br />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="card card-status bg-teal text-white border-0 shadow-lg">
                                        <div class="media">
                                            <i class="icon ion-thumbsdown"></i>
                                            <div class="media-body">
                                                <h1 class="text-white" id="_mfailedApplications"></h1>
                                                <p>Declined Requests</p>
                                                <br />
