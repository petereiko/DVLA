                            <i class="icon ion-android-hand tx-primary"></i>
                            <div class="media-body">
                                <h1 class="tx-primary" id="_availableSlotsOthers"></h1>
                                <p><b>Granted Access</b></p>
                                <p>Other Licences</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <br />
