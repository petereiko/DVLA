@using DVLA.DATA.Domains
@using DVLA.Data
@using DVLA.Data.Models.Auth
@using DVLA.Data.Models.DataObjects.ViewModels
@model UserViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <!-- ----------------------------------------- -->
        <!-- 1. Basic Form -->
        <!-- ----------------------------------------- -->
        <!-- start Basic Form -->
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Fill Form</h4>
                <form asp-action="Create" method="post">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="FirstName" placeholder="Enter First Name here" required />
                                <label for="FirstName">First Name</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="LastName" placeholder="Enter Last Name here" required />
                                <label for="LastName">Last Name</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" asp-for="Email" placeholder="name@example.com" required />
                                <label for="tb-email">Email address</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="Phone" placeholder="Enter Phone here" required />
                                <label for="Phone">Phone</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="MobileNumber" placeholder="Enter Additional Phone here" />
                                <label for="Phone">Additional Phone</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3" style="height:100px; overflow-y:scroll">
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" asp-for="Roles[i].Id"/>
                                        <input type="hidden" asp-for="Roles[i].Name" />
                                        <input class="form-check-input primary role-name" type="checkbox" data-rolename="@Model.Roles[i].Name" asp-for ="Roles[i].IsChecked" id="role_@i">
                                        <label class="form-check-label text-dark fs-3" for="role_@i">
                                            @Model.Roles[i].Name
                                        </label>
                                    </div>
                                }
                                
                            </div>
                        </div>
                        <div class="col-md-6" id="OptometristArea">
                            <div class="form-floating mb-3">
                                <select asp-for="OptometristFirmId" class="form-control">
                                    <option value="">Select an Optometrist Firm</option>
                                    @foreach (OptometristFirm item in (List<OptometristFirm>)ViewBag.OptometristFirms)
                                    {
                                        <option value="@item.Id">@item.BusinessName</option>
                                    }
                                </select>
                                <label for="Phone">Optometrist Firm</label>
                            </div>
                        </div>
                        <div class="col-md-6" style="display:none" id="PinDiv">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" asp-for="PIN" placeholder="Enter PIN" />
                                <label for="PIN">Personal Identification Number</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-md-flex align-items-center">

                                <div class="ms-auto mt-3 mt-md-0">
                                    <button type="submit" class="btn btn-primary hstack gap-6">

                                        Submit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- end Basic Form -->
    @section Scripts {
        @if (Model.Errors.Any())
        {
            <script>
                Swal.fire({
                    title: 'Error',
                    text: '@Model.Errors.FirstOrDefault()',
                    type: 'error'
                });
            </script>
        }

        <script>
            $(function () {
                $('#DefaultRole').change(function () {
                    let role = $(this).val();
                    let sysAdminRole = '@AppRoles.SYSTEMADMIN';
                    if (role == sysAdminRole) {
                        $('#OptometristArea').hide();
                    }
                    else {
                        $('#OptometristArea').show();
                    }
                });

                let _roleName="";
                let roles=[];

                $('.role-name').change(function(){
                    let role = $(this).attr('data-rolename')
                    if($(this).prop('checked')){
                        roles.push(role);
                    }
                    else{
                        roles = roles.filter(r=>r!=role);
                    }
                    if(roles.includes('@AppRoles.OPTOMETRIST')){
                        $('#PinDiv').show();
                    }
                    else{
                        $('#PinDiv').hide();
                    }
                });
            })
        </script>
    }




