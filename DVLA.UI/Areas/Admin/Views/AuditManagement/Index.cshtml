@using DVLA.DATA.Domains
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.DataObjects.ViewModels

@model AuditGridViewModel
@{

    ViewBag.Title = "Audit Management";
    var i = 0;
}

<div class="datatables">
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">@ViewBag.Title</h4>
            </div>
            <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">

                    <form asp-action="Index" asp-controller="AuditManagement" method="post">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <input type="text" asp-for="Filter.StartDate" required autocomplete="off" class="form-control mydatepicker" data-date-format="dd/mm/yyyy" />
                                    <label for="StartDate">Start Date</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <input type="text" asp-for="Filter.EndDate" required autocomplete="off" class="form-control mydatepicker" data-date-format="dd/mm/yyyy" />
                                    <label for="EndDate">End Date</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <select asp-for="Filter.Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="1">Male</option>
                                        <option value="2">Female</option>
                                    </select>
                                    <label for="Gender">Gender</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <select asp-for="Filter.PassOrFail" class="form-control">
                                        <option value="">Select Test Status</option>
                                        <option value="1">Pass</option>
                                        <option value="2">Fail</option>
                                    </select>
                                    <label for="PassOrFail">Test Status</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <select asp-for="Filter.ResultConclusion" class="form-control" asp-items="(SelectList)ViewBag.ResultConclusions">
                                        <option value="">Select Result Conclusion</option>
                                    </select>
                                    <label for="ResultConclusion">Result Conclusion</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating mb-3">
                                    <select asp-for="Filter.Nationalitiy" class="form-control" asp-items="@((List<SelectListItem>)ViewBag.Countries)">
                                        <option value="">--Select Nationality--</option>
                                    </select>
                                    <label for="Nationality">Nationality</label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div>

                                    <div>
                                        <button type="submit" class="btn btn-primary" formaction="/Admin/AuditManagement/ExportAudit">
                                            Export to Excel
                                        </button>
                                        <button type="submit" class="btn btn-primary" formaction="/Admin/AuditManagement/Index">
                                            Search
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>




                    <div class="d-flex mb-2 float-right">

                        @* <div class="d-flex">
                            @using (Html.BeginForm("ExportAudit", "AuditManagement", FormMethod.Post))
                            {
                                var sn = 0;
                                for (var n = 0; n < Model.Items.Count; n++)
                                {
                                    @Html.HiddenFor(x => x[n].Id)
                                    @Html.HiddenFor(x => x[n].BusinessName)
                                    @Html.HiddenFor(x => x[n].Applicant)
                                    @Html.HiddenFor(x => x[n].Gender)
                                    @Html.HiddenFor(x => x[n].Nationality)
                                    @Html.HiddenFor(x => x[n].PassOrFail)
                                    @Html.HiddenFor(x => x[n].ResultConclusion)
                                    @Html.HiddenFor(x => x[n].Status)
                                    @Html.HiddenFor(x => x[n].TestDate)
                                }

                                <button type="submit" id="add_row" class="btn btn-primary">
                                    <i class="fa fa-file"></i>
                                    <span>Export To Excel</span>
                                </button>
                            }

                        </div> *@
                    </div>

                    <div>
                        <div class="table-responsive">
                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th>
                                            SN
                                        </th>
                                        <th>
                                            Facility
                                        </th>
                                        <th>
                                            Applicant
                                        </th>

                                        <th>
                                            Gender
                                        </th>

                                        <th>
                                            Nationality
                                        </th>

                                        <th>Conclusion</th>

                                        <th>Service Type</th>

                                        <th>Age</th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (ActivityModel item in Model.Items)
                                    {
                                        i = i + 1;
                                        <tr>

                                            <td>@i</td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.BusinessName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Applicant)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.Gender)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.Nationality)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ResultConclusion)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.ResultServiceType)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.Age)
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



