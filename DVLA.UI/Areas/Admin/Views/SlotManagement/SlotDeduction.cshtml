                                <form>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <select asp-for="FormData.OptometristFirmId" class="form-control" asp-items="Model.OptometristFirms">
                                                    <option value="">Select an Optometrist Firm</option>
                                                </select>
                                                <label for="FormData_OptometristFirmId">Optometrist Firm</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <input type="number" class="form-control" asp-for="FormData.Quantity" placeholder="Enter Contact Last Name here" required />
                                                <label for="FormData_Quantity">Quantity</label>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-floating mb-3">
                                                <textarea asp-for="FormData.Comment" placeholder="Enter Comment..." required class="form-control"></textarea>
                                                <label for="FormData_Comment">Comment</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="d-md-flex align-items-center">

                                                <div class="ms-auto mt-3 mt-md-0">
                                                    <button onclick="ReduceSlot()" type="button" class="btn btn-primary hstack gap-6">
                                                        Reduce Access
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </section>
                        </center>
                    </div>
                </div>
            </div>


        </div>
    </div>

</div>


@section Scripts {
    <script>
        function ReduceSlot() {
            debugger
            let optometristFirmId = $('#FormData_OptometristFirmId').val();
            let quantity = $('#FormData_Quantity').val();
            let comment = $('#FormData_Comment').val();
            let obj = {
                OptometristFirmId: optometristFirmId,
                Quantity: quantity,
                Comment: comment
            };
            if (obj.OptometristFirmId == '') {
                Swal.fire({
                    title: 'Warning',
                    text: 'Select an Optometrist Firm',
                    icon: 'warning'
                });
                return;
            }
            if (obj.Quantity == '') {
                Swal.fire({
                    title: 'Warning',
                    text: 'Enter the quantity of access to be removed',
                    icon: 'warning'
                });
                return;
            }
            if (obj.Comment.trim() == '') {
                Swal.fire({
                    title: 'Warning',
                    text: 'Enter a comment',
                    icon: 'warning'
                });
                return;
            }
            let confirmationText = parseInt(obj.Quantity) > 1 ? "Yes, remove the access(s)!" : "Yes, remove the access"
            //alert(confirmationText)

            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to submit this form? Please note that once submitted, you cannot make changes!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, submit it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // User clicked "Ok" - set the IsSubmitted value to true
                    $.ajax({
                        url: '@Url.Action("SlotDeduction", "SlotManagement", new { area = "admin" })',
                        type: 'post',
                        dataType: 'json',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify(obj),
                        success: function (response) {
                            if (response.status) {
                                ClearForm();
                                Swal.fire({
                                    title: 'Success!',
                                    text: response.message,
                                    icon: 'success'
                                });
                            }
                            else {
                                Swal.fire({
                                    title: 'Error!',
                                    text: response.message,
                                    icon: 'error'
                                });
                            }

                            //setTimeout(function () {
                            //    location.reload();
                            //}, 2000);
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    });
                } else {
                    // User clicked "Cancel" - Do nothing
                    Swal.fire('Cancelled', 'The form was not submitted', 'info');
                }
            });

            // swal({
