            //             data: JSON.stringify(obj),
            //             success: function (response) {
            //                 if (response.status) {
            //                     ClearForm();
            //                     Swal.fire({
            //                         title: 'Success!',
            //                         text: response.message,
            //                         icon: 'success'
            //                     });
            //                 }
            //                 else {
            //                     Swal.fire({
            //                         title: 'Error!',
            //                         text: response.message,
            //                         icon: 'error'
            //                     });
            //                 }

            //                 //setTimeout(function () {
