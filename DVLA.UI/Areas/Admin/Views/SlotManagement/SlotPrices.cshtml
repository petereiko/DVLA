@using DVLA.Data.Models.DataObjects.DTOs
@model IEnumerable<SlotPriceModel>
@{
    ViewBag.Title = "Access Prices";
    int i = 0;
}



<div class="datatables">
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">@ViewBag.Title</h4>
            </div>
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">


                        <div class="d-flex mb-2 float-right">

                            <div class="d-flex">

                                <a asp-action="CreateSlotPrice" asp-asp-controller="SlotManagement" class="btn btn-primary">
                                    <i class="fa fa-plus"></i>
                                    <span>Add New</span>
                                </a>
                            </div>
                        </div>

                        <div>
                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Price
                                        </th>
                                        <th>Access Type</th>
                                        <th>Created By</th>
                                        <th>Date Created</th>
                                        <th>Updated By</th>
                                        <th>Date Updated</th>
                                        <th>
                                            Active
                                        </th>
                                        <th></th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        i = i + 1;
                                        <tr>
                                            <td>
                                                @i
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Price)
                                            </td>
                                            <td>
                                                @(item.AccessType == 0 ? "" : item.AccessType.ToString())
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedByFullName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedDate)
                                            </td>
                                            <td>@Html.DisplayFor(x => item.UpdatedByFullName)</td>
                                            <td>
                                                @if (item.ModifiedDate.HasValue)
                                                {
                                                    <text>@item.ModifiedDate.Value</text>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-success">active</span>
                                                }
                                                else
                                                {
                                                    <span class="mb-1 badge rounded-pill text-bg-danger">inactive</span>
                                                }
                                            </td>
                                            <td style="text-align:right;">
                                                <a asp-action="EditSlotPrice" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






@section Scripts {
    <script>
        $('#class-of-company-datagridview').dataTable()

    </script>
}

