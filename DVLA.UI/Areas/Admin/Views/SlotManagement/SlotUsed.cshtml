@using DVLA.Data.Models.DataObjects.ViewModels
@using DVLA.Data.Models.Enumerables
@model SlotStatisticsViewModel
@{
    ViewBag.Title = "Used Slot";
    int counter = 0;
}

<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">@ViewBag.Title</h4>
            </div>
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">


                        <form asp-action="SlotUsed" asp-asp-controller="Slot" method="post" style="margin-bottom:30px;" class="form-horizontal">

                            <div class="row">
                                <div class="col-md-3">
                                    <label>Start Date</label>
                                    <input type="text" asp-for="SlotStatisticsFilter.StartDate" class="form-control" data-date-format="dd/mm/yyyy" autocomplete="off" />
                                </div>

                                <div class="col-md-3">
                                    <label>End Date</label>
                                    <input type="text" asp-for="SlotStatisticsFilter.EndDate" class="form-control" data-date-format="dd/mm/yyyy" autocomplete="off" />
                                </div>

                                <div class="col-md-3">
                                    <label> Service Type </label>
                                    <select asp-for="SlotStatisticsFilter.AccessType" asp-items="Html.GetEnumSelectList<AccessType>()" class="form-control">
                                        <option>All</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <span></span>
                                    <span></span>
                                    <button type="submit" class="btn btn-primary pull-left" style="margin-top:20px;">Search</button>
                                </div>
                            </div>

                        </form>

                        <br />
                        <div>Total Slot Used: <strong>@Model.TotalQuantity</strong></div>

                        <div class="table-responsive">
                            <table id="file_export" class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th>
                                            #
                                        </th>
                                        <th>
                                            Optometrist
                                        </th>
                                        <th>Slot Used</th>
                                        <th>
                                            Access Type
                                        </th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        counter = counter + 1;
                                        <tr>
                                            <td>
                                                @counter
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.OptometristFirmName)
                                            </td>
                                            <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AccessType)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <script>

        $(document).ready(function () {
            $("#SlotStatisticsFilter_StartDate").datepicker({
                dateFormat: "dd-mm-yyyy"
            });
            $("#SlotStatisticsFilter_EndDate").datepicker({
                dateFormat: "dd-mm-yyyy"
            });

        });
    </script>
}












