@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.DataObjects.UtilityObjects
@using DVLA.Data.Models.DataObjects.ViewModels
@model IEnumerable<VisualAssessmentResultItemViewModel>
@{
    ViewBag.Title = "Transmit Result";
    ViewData["Area"] = "Admin";
    int counter = 0;
    string term = Context.Request.Query["term"].ToString();
}



<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">Biodata Update</h4>
            </div>
            <div class="section-wrapper">
                <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                    <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">
                        <form asp-action="Index" asp-controller="TransmitResult" asp-route-term="">
                            <div class="row">
                                <div class=col-4>
                                    <input class="form-control" id="term" name="term"
                                        placeholder="Enter First name, Surname, Reference..." />
                                </div>
                                <div>
                                    <button type="sumbit" class="btn btn-success">Search...</button>
                                </div>

                            </div>
                        </form>
                        <div class="table-responsive">
                            <table id="file_export"
                                class="table w-100 table-striped table-bordered display text-nowrap">
                                <thead>
                                    <tr>
                                        <th class="width-10px text-center">#</th>
                                        <th>Names</th>
                                        <th>Address</th>
                                        <th>Company</th>
                                        <th>DS Reference</th>
                                        <th>Test Date</th>
                                        <th>Grade</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        counter = counter + 1;
                                        <tr>
                                            <td>
                                                @counter
                                            </td>
                                            <td><span>@item.ApplicantName </span></td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ApplicantAddress)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.OptometristFirmName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.DSReference)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.TestDate)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Grade)
                                            </td>
                                            <td>
                                                @if (item.Status == "Transmitted")
                                                {
                                                    <span style="color:green">@item.Status</span>
                                                }
                                                else
                                                {
                                                    <span style="color:red">@item.Status</span>
                                                }
                                            </td>

                                            <td>
                                                <a asp-action="Detail" asp-controller="VisualAssessmentResult"
                                                    asp-area="Customer" asp-route-page="Details"
                                                    asp-route-token="@Utility.Encrypt(item.Id.ToString())">Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {

    <script>
        $(function () {
            $('#file_export_info').hide();
            $('#file_export_paginate').hide();
            $('#dataTables_info').hide();
        });
    </script>
}





