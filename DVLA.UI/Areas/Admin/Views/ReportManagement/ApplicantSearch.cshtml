@using DVLA.Data.Models.DataObjects.ViewModels
@model ClientViewModel
@{
    ViewBag.Title = "Applicant Search";
}

<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="section-wrapper">

                <div class="section-wrapper">
                    <div id="class-of-company-module" class="vatebra-manage-component stackable-panel">
                        <div class="panel manage-products-listing-panel" selected id="manage-products-listing-component">



                            <div>
                                @using (Html.BeginForm("ApplicantSearch", "ReportManagement", FormMethod.Post))
                                {
                                    <table>
                                        <tr>
                                            @*<td>@Html.TextBoxFor(x => x.SearchParameter.ApplicantName, new { placeholder = "Applicant Name", @class = "form-control" })</td>*@
                                            <td>
                                                <div class="form-floating mb-3">
                                                    <input type="text" class="form-control" asp-for="SearchParameter.DriversLicenceNumber" placeholder="Drivers Licence Number" required />
                                                    <label for="SearchParameter_DriversLicenceNumber">Drivers Licence Number</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-floating mb-3">
                                                    <input type="text" class="form-control" asp-for="SearchParameter.DVLANumber" placeholder="DVLA Number" required />
                                                    <label for="SearchParameter_DVLANumber">DVLA Number</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-floating mb-3">
                                                    <input type="text" class="form-control" asp-for="SearchParameter.TestCenter" placeholder="Test Center" required />
                                                    <label for="SearchParameter_TestCenter">Test Center</label>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="form-floating mb-3">
                                                    <input type="text" class="form-control" asp-for="SearchParameter.ReferenceNumber" placeholder="Reference Number" required />
                                                    <label for="SearchParameter_ReferenceNumber">Reference Number</label>
                                                </div>
                                            </td>
                                            <td><input type="submit" value="Search Client" class="btn btn-primary" /></td>
                                        </tr>

                                    </table>
                                }
                                <div class="table-responsive">
                                    <partial name="_ClientSearch" model="Model.Clients" />
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modal-reject-reason" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Reason</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <label>Reason:</label>

                        @Html.TextArea("Reason", new { @class = "form-control" })
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i> Close</button>
                <button type="button" onclick="DeleteRequestNow()" class="btn btn-primary"><i class="fa fa-save"></i> Submit</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
    </script>
}


