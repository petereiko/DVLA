@using DVLA.Data
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.DataObjects.ViewModels
@using DVLA.Data.Models.Enumerables
@{
    ViewBag.Title = "Eye Test Results";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model ApplicantModel


<div class="datatables">
    <!-- start File export -->
    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <h4 class="card-title mb-0">Eye Test Results</h4>
            </div>
            <div id="DivIdToPrint">
                <div class="card form-card">
                    <div class="card-body">

                        <div class="container">
                            <br />


                        </div>
                        <br />
                        <form asp-action="Create" method="post" enctype="multipart/form-data" id="target">
                            <div class="container">
                                @if (Model.Errors.Any())
                                {
                                    <div class="alert alert-danger">@Model.Errors.FirstOrDefault()</div>
                                }
                            </div>



                            <input type="hidden" asp-for="PassportImageUrl" />
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="Status" />
                            <input type="hidden" asp-for="ReferenceNumber" />
                            <input type="hidden" asp-for="OptometristFirmId" />


                            <div class="container">
                                <br />
                                <div id="ServiceTypeArea">
                                    <ul class="nav nav-tabs" id="ServiceTypeTab">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab">Service Type</a>
                                        </li>

                                    </ul>
                                </div>
                                <br />
                                <div class="row row-xs mg-b-10">


                                    <div class="col-4">
                                        Service Type
                                        <select asp-for="ResultServiceType" class="form-control" asp-items="Html.GetEnumSelectList<ResultServiceType>()">
                                            <option>Select Service Type</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.ResultServiceType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <br />

                                <div id="DetailsOfApplicant">
                                    <ul class="nav nav-tabs" id="DetailsOfApplicantTab">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="tab">Details of Applicant</a>
                                        </li>

                                    </ul>
                                    <br />
                                    <div class="tab-content mb-4">
                                        <div class="tab-pane active" id="DetailsTab">

                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    Surname
                                                    @Html.TextBoxFor(model => model.Surname, new { @class = "form-control", @autocomplete = "off" })

                                                    @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    First Name
                                                    @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", @autocomplete = "off" })

                                                    @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-sm mg-t-10 mg-sm-t-0">
                                                    Other Name
                                                    @Html.TextBoxFor(model => model.OtherName, new { @class = "form-control", @autocomplete = "off" })

                                                </div>
                                                <div class="col-sm">
                                                    Date of Birth (DD/MM/YYYY)
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" asp-for="DOB" autocomplete="off" data-date-format="dd/mm/yyyy" />
                                                        <div class="input-group-addon">
                                                            <span class="glyphicon glyphicon-th"></span>
                                                        </div>
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger" })
                                                    @Html.HiddenFor(model => model.DateOfBirth)
                                                </div>
                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    Digital/Residential Address

                                                    @Html.TextAreaFor(model => model.PostalAddress, new { @class = "form-control" })
                                                    @Html.ValidationMessageFor(model => model.PostalAddress, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    Gender

                                                    <select asp-for="Gender" class="form-control" required asp-items="@Html.GetEnumSelectList<Gender>()">
                                                        <option value="">--Select Gender--</option>
                                                    </select>
                                                    @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })

                                                </div>

                                            </div>
                                            <div class="row row-xs mg-b-10">

                                                <div class="col-sm">
                                                    Contact Number
                                                    @Html.TextBoxFor(model => model.ContactNumber, new { @class = "form-control", @autocomplete = "off" })
                                                    @Html.ValidationMessageFor(model => model.ContactNumber, "", new { @class = "text-danger" })

                                                </div>
                                                <div class="col-sm">
                                                    Nationality
                                                    <select asp-for="Nationality" class="form-control" asp-items="@((List<SelectListItem>)ViewBag.Countries)">
                                                        <option value="">--Select Nationality--</option>
                                                    </select>
                                                    @Html.ValidationMessageFor(model => model.Nationality, "", new { @class = "text-danger" })
                                                </div>
                                                <div class="col-sm">
                                                    Email (if applicable)
                                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @autocomplete = "off" })

                                                </div>

                                                <div class="col-sm">
                                                    <input type="hidden" asp-for="IdentityType" />
                                                    <div id="identity-number-area" style="display:none">
                                                        <label id="identity-number-label">Ghana Card Number</label>
                                                        <input type="text"
                                                               id="identity-number-input"
                                                               class="form-control"
                                                               value="@(string.IsNullOrEmpty(Model.GhanaCardNumber) ? Model.PassportNumber : Model.GhanaCardNumber)"
                                                               autocomplete="off" />
                                                        <span asp-validation-for="GhanaCardNumber" class="text-danger"></span>
                                                        <span asp-validation-for="PassportNumber" class="text-danger"></span>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12 mb-2">
                                    <div class="row">
                                        <div class="col-lg-6 text-left">
                                            <a href="@Url.Action("Index","FrontOffice")" class="btn btn-secondary">Back to Application List</a>


                                        </div>
                                        <div class="col-lg-6 text-right">

                                                <input type="submit" id="btnSubmit" class="btn btn-primary" value="Submit" />

                                           
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>

        $(function(){
                 $("#DOB").datepicker({
            dateFormat: "dd-mm-yyyy",
        });
        })

    </script>
    <script>
        $(function(){
            function updateIdentityNumberInput() {
                const nationality = ($('#Nationality').val() || '').toLowerCase();
                const isGhanaian = nationality === 'ghana' || nationality === 'ghanaian';
                const hasNationality = nationality.length > 0;
                const input = $('#identity-number-input');

                $('#identity-number-area').toggle(hasNationality);

                if (isGhanaian) {
                    $('#identity-number-label').text('Ghana Card Number');
                    $('#IdentityType').val('@((int)IdentityType.NationalIDCard)');
                    input.attr('name', 'GhanaCardNumber');
                    input.attr('placeholder', 'Enter your Ghana Card Number');
                } else {
                    $('#identity-number-label').text('Passport Number');
                    $('#IdentityType').val('@((int)IdentityType.InternationalPassport)');
                    input.attr('name', 'PassportNumber');
                    input.attr('placeholder', 'Enter your Passport Number');
                }

                input.prop('required', hasNationality);
            }

            $('#Nationality').change(updateIdentityNumberInput);
            updateIdentityNumberInput();
        })
    </script>
}
