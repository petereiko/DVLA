@using DVLA.DATA.Domains
@using DVLA.Data.Models.DataObjects.DTOs
@using DVLA.Data.Models.Enumerables
@using Microsoft.Extensions.Configuration
@inject IConfiguration _config;
@model ApplicantModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
    int passportMaxSize = Convert.ToInt32(_config["AppConstants:PassportMaxSize"]);
}


<div class="row">
    <div class="col-12">
        <!-- ----------------------------------------- -->
        <!-- 1. Basic Form -->
        <!-- ----------------------------------------- -->
        <!-- start Basic Form -->
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Fill Form</h4>
                <div id="DivIdToPrint">
                    <div class="card form-card">
                        <div class="card-body">

                            

                            <form asp-action="Create" asp-controller="OnlineApplicant" method="post" enctype="multipart/form-data">
                                
                                <div class="container">

                                    <br />
                                    <div id="loading" style="display: none;">
                                        <table style="height: 100%; border: 0; width: 100%; position: fixed; top: 0; left: 0; background-color: #FAFAFA; opacity: 0.8; filter: alpha(opacity=80); z-index: 9000;">
                                            <tbody>
                                                <tr>
                                                    <td style="width: 100%; text-align:center; vertical-align : middle;">
                                                        <div id="Loadingtext" style="font-family: Arial; font-size: 24px; opacity: 1; filter: alpha(opacity=100); font-weight: bold; color: #000000; text-align: center; padding-top: 5px;"><img src="//i.stack.imgur.com/FhHRx.gif" />&nbsp;Please wait...</div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-4" style="padding:0px">
                                            <video id="video" autoplay style="height: 200px;clip-path: inset(0px 20px 0px 20px); border:1px solid black"></video>
                                            <button onclick="Capture()" style="margin-left:20px" id="capture" class="btn btn-primary">Capture</button>
                                        </div>
                                        <div class="col-sm-4" style="padding:0px">
                                            <canvas id="canvas" width="200" height="200" />
                                            <img src="" id="photo" style="height: 200px; width:200px; border:1px solid black" />


                                        </div>
                                        <div class="col-sm-4">
                                            Upload Image <strong style="color:red">(Max Passport Size @passportMaxSize KB)</strong>
                                            <div style="margin-bottom:0px !important; padding-bottom:0px !important;">
                                                <input type="file" asp-for="Image" class="form-control" accept="image/jpeg" />
                                                @Html.ValidationMessageFor(m => m.Image, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>




                                </div>
                                <br />
                                <input type="hidden" asp-for="PassportImageUrl"/>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-floating mb-3">
                                            <select asp-for="OptometristFirmId" class="form-control" required>
                                                <option value="">Select Optometrist Firm</option>
                                                @foreach (OptometristFirm item in (List<OptometristFirm>)ViewBag.OptometristFirms)
                                                {
                                                    <option value="@item.Id">@item.BusinessName</option>
                                                }
                                            </select>
                                            <label for="OptometristFirmId">Optometrist Firm</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @* <div class="col-md-4">
