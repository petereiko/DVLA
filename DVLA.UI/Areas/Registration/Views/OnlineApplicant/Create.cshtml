                                            <input type="text" class="form-control" asp-for="DriversLicence" placeholder="Enter Driver's License Number" required>
                                            <label for="DriversLicence">Driver's License</label>
                                        </div>
                                    </div> *@
                                    @* <div class="col-md-4">
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" asp-for="DVLAReferenceNo" placeholder="Enter DVLA Reference No" required>
                                            <label for="DVLAReferenceNo">DVLA Reference No</label>
                                        </div>
                                    </div> *@
                                </div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" asp-for="Surname" placeholder="Enter Surname" required>
                                            <label for="Surname">Surname</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" asp-for="FirstName" placeholder="Enter Firsr Name" required>
                                            <label for="FirstName">First Name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" asp-for="OtherName" placeholder="Enter Other Name">
                                            <label for="OtherName">Other Name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" asp-for="DateOfBirth" data-date-format="yyyy-mm-dd" placeholder="Enter Date of Birth" required>
                                            <label for="DOB">Date of Birth</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-floating mb-3">
                                            <select asp-for="Gender" class="form-control" required asp-items="@Html.GetEnumSelectList<Gender>()">
