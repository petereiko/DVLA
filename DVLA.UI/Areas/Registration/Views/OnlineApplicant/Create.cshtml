                                            <input type="text" class="form-control" asp-for="InvoiceNumber" placeholder="Enter DVLA Invoice Number" required>
                                            <label for="InvoiceNumber">DVLA Invoice Number</label>
                                        </div>
                                    </div> *@
                                    <div class="col-md-4">
                                        <div class="form-floating mb-3">
                                            <select asp-for="ResultServiceType" class="form-control" required asp-items="@Html.GetEnumSelectList<ResultServiceType>()">
                                                <option value="">Select Test Type</option>
                                            </select>
                                            <label for="ResultServiceType">Service Type</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4" id="LearnerType" style="display:none">
                                        <div class="form-floating mb-3">
